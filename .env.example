# Story2Video environment configuration
# Copy to .env and fill in values as needed.

# --- LLM (Ollama) ---
# OLLAMA_BASE=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:9b

# --- Local video generation (Wan 2.1) ---
# WAN_MODEL=Wan-AI/Wan2.1-T2V-1.3B-Diffusers

# --- Hailuo / MiniMax cloud video ---
# MINIMAX_API_KEY=

# --- Fal.ai cloud video ---
# FAL_KEY=
# FAL_MODEL=fal-ai/wan-t2v
# FAL_RESOLUTION=480p

# --- Venice.ai cloud video ---
# VENICE_API_KEY=
# VENICE_MODEL=wan-2.5-preview-text-to-video

# SAM2_CHECKPOINT="facebook/sam2.1-hiera-large"
# # cuda or cpu
# SAM2_DEVICE="cuda"

# --- Logging ---
# S2V_LOG_LEVEL=INFO
